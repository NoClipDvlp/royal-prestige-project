# Royal Control — variables de entorno (Hito 0)
# Copia este archivo a .env.local y rellena con los valores de tu proyecto Supabase.
# .env y .env.local están en .gitignore: NUNCA se suben al repo.

# Supabase — cliente público (browser). La anon key respeta la RLS de Postgres.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# Server-only (NO NEXT_PUBLIC): API admin de GoTrue (alta/reset de usuarios). Bypasea la RLS → llave maestra.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# SMTP del correo de alta (#3) — Google Workspace, FROM info@pistacore.com. Server-only (NO NEXT_PUBLIC).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@pistacore.com
SMTP_PASS=your-workspace-app-password
SMTP_FROM=Pistacore <info@pistacore.com>

# NOTA DE SEGURIDAD:
# service_role y SMTP_* son secretos de servidor: NUNCA con prefijo NEXT_PUBLIC_, nunca en el cliente,
# nunca en el repo (.env* está en .gitignore). La anon key (pública) es la única que va al navegador.
