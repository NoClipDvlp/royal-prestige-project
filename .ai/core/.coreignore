# .coreignore — Rutas protegidas (núcleo intocable)
# El check de CI (core-guard) bloquea cualquier cambio a estas rutas
# salvo que el commit incluya el marcador [CORE-APPROVED: ADR-XXXX].
# Una ruta por línea. Soporta globs estilo gitignore.

# --- Modelo de datos (la verdad) ---
# El schema vive en migraciones (db/migrations/0000_init.sql), no en db/schema.sql.
# Se protege el directorio de migraciones COMPLETO — toda migración futura, no solo 0000_* (ADR-0004 / DEBT-0003).
db/migrations/
db/seed/roles.sql

# --- Seguridad y control de acceso ---
lib/auth/
lib/rbac/
lib/rls-policies/

# --- Motor de sincronización de calendario ---
lib/calendar/sync-core.ts

# --- Gobernanza de IA (no auto-modificable) ---
.ai/

# --- Núcleo explícito ---
core/

# --- Configuración crítica de build/infra ---
# next.config.* cubre .mjs/.ts/.js (un rename no esquiva el guard) (ADR-0004 / DEBT-0002).
next.config.*
middleware.ts

# --- Autoprotección del guard (ADR-0004 / DEBT-0001 ítem 3) ---
.github/workflows/core-guard.yml
